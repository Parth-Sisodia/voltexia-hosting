<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Voltexia Hosting</title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>
  <body>
    <div class="container">
      <div class="header my-4">
        <h1><a href="/">Voltexia Hosting</a></h1>
        <div style="position:relative;">
          <% if (user) { %>
            <img id="avatar" class="avatar" src="<%= user.avatar %>" alt="avatar" />
            <div id="avatar-dropdown" class="dropdown">
              <div><a href="/settings">Settings</a></div>
              <div><a href="/auth/logout">Logout</a></div>
            </div>
          <% } else { %>
            <a href="/auth/discord" class="btn btn-primary">Login with Discord</a>
          <% } %>
        </div>
      </div>

      <main>
        <% if (featured) { %>
          <div class="card">
            <h2>Most Popular: <%= featured.name %></h2>
            <p><%= featured.description %></p>
            <p><strong>Price:</strong> <%= featured.price %> USDT</p>
            <% if (user) { %>
              <form action="/purchase/<%= featured._id %>" method="post">
                <button class="btn btn-success">Purchase</button>
              </form>
            <% } else { %>
              <a href="/auth/discord" class="btn btn-primary">Login to Purchase</a>
            <% } %>
          </div>
        <% } else { %>
          <div class="card">
            <h2>No featured plan</h2>
          </div>
        <% } %>
      </main>

      <footer class="mt-5">
        <a href="/tos.html">Terms</a> | <a href="/privacy-policy.html">Privacy</a>
      </footer>
    </div>

    <script src="/js/client.js"></script>
  </body>
</html>
