<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Settings - Voltexia Hosting</title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>
  <body>
    <div class="container">
      <div class="header my-4">
        <h1><a href="/">Voltexia Hosting</a></h1>
        <div style="position:relative;">
          <% if (user) { %>
            <img id="avatar" class="avatar" src="<%= user.avatar %>" alt="avatar" />
            <div id="avatar-dropdown" class="dropdown">
              <div><a href="/settings">Settings</a></div>
              <div><a href="/auth/logout">Logout</a></div>
            </div>
          <% } else { %>
            <a href="/auth/discord" class="btn btn-primary">Login with Discord</a>
          <% } %>
        </div>
      </div>

      <div class="card">
        <h2>Settings</h2>
        <form method="post" action="/settings">
          <div class="mb-3">
            <label class="form-label">Username</label>
            <input class="form-control" name="username" value="<%= user.username %>" />
          </div>
          <div class="mb-3">
            <label class="form-label">Crypto Billing Address</label>
            <input class="form-control" name="cryptoAddress" value="<%= user.cryptoAddress || '' %>" />
          </div>
          <button class="btn btn-primary">Save</button>
        </form>
      </div>

      <div class="card">
        <h3>Discord Info</h3>
        <p><strong>Discord:</strong> <%= user.username %></p>
        <p><strong>Email:</strong> <%= user.email %></p>
      </div>

      <div class="card">
        <h3>Your Servers</h3>
        <% if (servers && servers.length) { %>
          <ul>
            <% servers.forEach(s => { %>
              <li><%= s.name %> (plan: <%= s.plan %>)</li>
            <% }) %>
          </ul>
        <% } else { %>
          <p>You don't own any servers yet.</p>
        <% } %>
      </div>

      <footer class="mt-5">
        <a href="/tos.html">Terms</a> | <a href="/privacy-policy.html">Privacy</a>
      </footer>
    </div>

    <script src="/js/client.js"></script>
  </body>
</html>
